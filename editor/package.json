{
  "name": "ezhtml-editor",
  "version": "0.1.0",
  "description": "EZHTML desktop editor with live preview",
  "main": "electron/main.cjs",
  "type": "module",
  "private": true,
  "author": "EZHTML Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "monaco-editor": "^0.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.15.0",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "build": {
    "appId": "org.ezhtml.editor",
    "productName": "EZHTML Editor",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.developer-tools" },
    "linux": { "target": "AppImage", "category": "Development" }
  }
}
