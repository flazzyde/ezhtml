# Example environment file.
# Copy this file to `.env` and fill in real values locally.
# DO NOT commit `.env`, real secrets or API keys to git.

# Compiler telemetry (anonymous, opt-in)
EZHTML_TELEMETRY=false

# Editor preview port
EZHTML_DEV_PORT=5173

# VS Code extension development
VSCODE_EXTENSION_HOST=vscode

# Website / playground
PLAYGROUND_PREVIEW_DEBOUNCE_MS=200
