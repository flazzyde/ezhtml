# Pricing table layout.

title "Pricing"
subtitle "One plan per row. The advisor on the right."

space

table
    headers "Plan", "Users", "Storage", "Price / mo"
    rows
        row_ "Starter", "1", "1 GB", "$0"
        row_ "Pro", "5", "100 GB", "$19"
        row_ "Team", "25", "1 TB", "$49"
        row_ "Enterprise", "∞", "∞", "Let's talk"

space

button "Choose Pro" "#signup"
