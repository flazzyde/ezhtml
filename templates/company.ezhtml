# Company website template — hero, services, team, contact.

header
    title "Northwind Co."
    subtitle "Engineering. Delivered."

section
    title "We build software that lasts."
    text "Northwind partners with scale-ups to ship robust, maintainable systems."
    button "See case studies" "#work"

section
    title "What we do"
    row
        column
            card
                title "Platform Engineering"
                text "Kubernetes, observability, build pipelines."
        column
            card
                title "Frontend Craft"
                text "Type-safe React & Rust/WASM applications."
        column
            card
                title "Data Infrastructure"
                text "Pipelines, warehousing and analytics."

section
    title "The team"
    row
        column
            card
                title "Anna Carter"
                text "Co-founder, CEO"
        column
            card
                title "Brian Yu"
                text "Co-founder, CTO"

section
    title "Talk to us"
    text "hello@northwind.example"
    email "email"
    textarea "message" "Tell us about your project"
    button "Send" "#"

footer
    text "© 2025 Northwind Co."
    link "https://github.com/ezhtml/ezhtml" "Built with EZHTML"
