# Portfolio template — showcase projects with cards.

header
    title "Jane Doe"
    subtitle "Frontend engineer & illustrator"
    link "#work" "Work"
    link "#about" "About"
    link "#contact" "Contact"

section
    title "Selected work"
    row
        column
            card
                title "Realtime Notebook"
                text "Collaborative editor in Rust + WASM."
                button "Visit" "#"
        column
            card
                title "Lightfield Maps"
                text "Vector map renderer for the open web."
                button "Visit" "#"
        column
            card
                title "Type Foundry"
                text "Variable font playground."
                button "Visit" "#"

section
    title "About"
    text "I build tools that get out of the way so designers can focus on their craft."

section
    title "Get in touch"
    text "hello@example.com"
    button "Email me" "mailto:hello@example.com"

footer
    text "© 2025 Jane Doe"
    link "#github" "GitHub"
    link "#dribbble" "Dribbble"
    link "#linkedin" "LinkedIn"
