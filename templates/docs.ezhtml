# Documentation site template — sidebar nav + content sections.

header
    title "EZHTML Documentation"
    subtitle "Reference manual + tutorials"
    link "#guide" "Guide"
    link "#api" "CLI"
    link "#syntax" "Syntax"

section
    title "Getting started"
    text "Install the compiler, write your first .ezhtml file, run ezhtml build."
    code "cargo install ezhtml-cli\nezhtml init\nezhtml build"
    button "Read the full guide" "#guide"

section
    title "CLI reference"
    text "Every command explained."
    code "ezhtml build input.ezhtml -o output.html\nezhtml preview input.ezhtml --port 8080\nezhtml doctor input.ezhtml"
    list
        item
            text "build — compile to HTML"
        item
            text "preview — watch + live reload"
        item
            text "doctor — validation report"

footer
    text "EZHTML is open source (MIT)."
    link "https://github.com/ezhtml/ezhtml" "GitHub"
