# Landing Page template — hero, features, CTA, footer.
# Build:   ezhtml build landing.ezhtml -o landing.html
# Preview: ezhtml preview landing.ezhtml

navbar
    link "#top" "Home"
    link "#features" "Features"
    link "#cta" "Get in touch"

section
    title "Ship beautiful pages in minutes."
    subtitle "EZHTML turns a handful of keywords into clean HTML."
    button "Read the docs" "https://ezhtml.flazzy.de/docs"
    button "GitHub" "https://github.com/ezhtml/ezhtml"

space

section
    title "Features"
    row
        column
            card
                icon "rocket"
                title "Fast"
                text "Compiled to a single static binary in Rust."
        column
            card
                icon "shield"
                title "Safe"
                text "Validator catches accessibility & SEO issues."
        column
            card
                icon "sparkles"
                title "Simple"
                text "Indentation = hierarchy. No closing tags."

space

section
    title "Built for makers."
    text "EZHTML was created for everyone who ever forgot a closing div."
    button "Start now" "https://ezhtml.flazzy.de/start"

footer
    text "© 2025 flazzyde · MIT License"
    link "https://github.com/ezhtml/ezhtml" "Source on GitHub"
