# Dashboard template — sidebar nav, KPI cards, table, activity feed.

html "<link rel=\"stylesheet\" href=\"assets/css/main.css\">"
html "<script src=\"assets/js/main.js\" defer></script>"

header
    title "Acme Dashboard"
    subtitle "Site health overview"
    text "Refreshed every minute. Click any column header on the table to sort."

section
    row
        column
            card
                title "Active users"
                text "12,438"
                text "+4.2% this week"
        column
            card
                title "Revenue"
                text "$48,201"
                text "+1.8% this week"
        column
            card
                title "Open issues"
                text "37"
                text "-12 since yesterday"
        column
            card
                title "NPS"
                text "+62"
                text "+3 from last survey"

divider

section
    title "Traffic (last 7 days)"
    html "<div class=\"chart\" id=\"traffic-chart\" aria-label=\"Traffic bar chart\"></div>"

section
    title "Top customers"
    text "Click a column header to sort. Tie-break is the original row order."
    table
        headers "Customer", "Plan", "MRR", "Status"
        rows
            row_ "Acme Corp", "Pro", "$420", "Active"
            row_ "Globex", "Team", "$180", "Active"
            row_ "Initech", "Starter", "$49", "Trial"
            row_ "Hooli", "Enterprise", "$2,400", "Active"
            row_ "Soylent", "Pro", "$420", "Past due"
            row_ "Stark Industries", "Enterprise", "$5,800", "Active"

section
    title "Recent activity"
    list
        item
            text "Acme Corp upgraded from Team to Pro"
        item
            text "Globex integrated the v2 webhook"
        item
            text "Hooli renewed their Enterprise contract for 12 months"
        item
            text "Soylent's payment failed twice — automated retry scheduled"

footer
    text "Last refresh: just now · built with EZHTML"
    link "#status" "Status page"
    link "#docs" "API docs"
